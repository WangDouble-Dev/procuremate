{
  "name": "dsh-procurement-workbench",
  "version": "0.3.3",
  "type": "module",
  "description": "个人采购工作台：Excel 询价、合作供货商、价格回填与场景提醒",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "templates",
    "VALIDATION.md",
    "COMPATIBILITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "esbuild": "0.25.10",
    "exceljs": "4.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
